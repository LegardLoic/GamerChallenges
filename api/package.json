  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch index.ts",
    "======= PRISMA =======": "========= PRIMSA ===========",
    "db:generate": "prisma generate --schema=./src/models/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./src/models/schema.prisma --name auto",
    "db:migrate:reset": "prisma migrate reset --force --schema=./src/models/schema.prisma",
    "db:seed": "tsx --env-file=.env ./src/models/seeds/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
